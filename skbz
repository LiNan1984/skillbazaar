#!/usr/bin/env python3
"""
skbz — SkillBazaar CLI工具
让Agent和开发者通过命令行操作SkillBazaar所有功能
参考: CLI-Anything (HKUDS) + opencli (jackwener)
"""
import argparse
import json
import os
import sys
import subprocess
from urllib.request import Request, urlopen
from urllib.error import HTTPError
from urllib.parse import urlencode

# Config
SKBZ_API = os.environ.get("SKBZ_API", "https://skillbazaar.harness-agent.app/api")
SKBZ_TOKEN = os.environ.get("SKBZ_TOKEN", "")
SKBZ_TOKEN_FILE = os.path.expanduser("~/.skbz_token")


def _load_token():
    """Load auth token from env or file"""
    global SKBZ_TOKEN
    if SKBZ_TOKEN:
        return SKBZ_TOKEN
    if os.path.exists(SKBZ_TOKEN_FILE):
        with open(SKBZ_TOKEN_FILE) as f:
            SKBZ_TOKEN = f.read().strip()
    return SKBZ_TOKEN


def _api(method: str, path: str, data: dict = None, raw: bool = False):
    """Call SkillBazaar API"""
    url = f"{SKBZ_API}{path}"
    headers = {"Content-Type": "application/json"}
    token = _load_token()
    if token:
        headers["Authorization"] = f"Bearer {token}"

    body = json.dumps(data).encode() if data else None
    req = Request(url, data=body, headers=headers, method=method.upper())

    try:
        with urlopen(req, timeout=30) as resp:
            result = resp.read().decode()
            if raw:
                return result
            return json.loads(result) if result else {}
    except HTTPError as e:
        error_body = e.read().decode()[:500]
        try:
            error_json = json.loads(error_body)
            detail = error_json.get("detail", error_body)
        except Exception:
            detail = error_body
        print(f"❌ API Error {e.code}: {detail}", file=sys.stderr)
        sys.exit(1)


def _pprint(data):
    """Pretty print JSON"""
    if isinstance(data, str):
        try:
            data = json.loads(data)
        except Exception:
            pass
    print(json.dumps(data, ensure_ascii=False, indent=2))


# ==================== Auth ====================

def cmd_auth_login(args):
    """登录获取token"""
    data = {"email": args.email, "password": args.password}
    # Try login endpoint
    result = _api("post", "/v2/auth/login", data)
    token = result.get("token") or result.get("access_token", "")
    if token:
        with open(SKBZ_TOKEN_FILE, "w") as f:
            f.write(token)
        os.chmod(SKBZ_TOKEN_FILE, 0o600)
        print(f"✅ 登录成功! Token saved to {SKBZ_TOKEN_FILE}")
    else:
        print(f"❌ 登录失败: {result}")


def cmd_auth_register(args):
    """注册新用户"""
    data = {
        "email": args.email,
        "password": args.password,
        "nickname": args.nickname or args.email.split("@")[0],
    }
    result = _api("post", "/v2/auth/register", data)
    _pprint(result)
    print("✅ 注册成功! 请用 skbz auth login 登录")


def cmd_auth_whoami(args):
    """查看当前用户"""
    result = _api("get", "/v2/auth/me")
    _pprint(result)


# ==================== Products ====================

def cmd_product_list(args):
    """列出商品/技能"""
    params = {}
    if args.category:
        params["category"] = args.category
    if args.search:
        params["search"] = args.search
    if args.page:
        params["page"] = args.page
    qs = urlencode(params) if params else ""
    path = f"/products/?{qs}" if qs else "/products/"
    result = _api("get", path)
    products = result.get("products", result) if isinstance(result, dict) else result
    if isinstance(products, list):
        for p in products[:20]:
            print(f"  [{p.get('id','?')}] {p.get('name','?')} — ¥{p.get('price',0)} | {p.get('category','')} | 👥{p.get('sales_count',0)}")
        total = result.get("total", len(products)) if isinstance(result, dict) else len(products)
        print(f"\n  共 {total} 个商品")
    else:
        _pprint(result)


def cmd_product_info(args):
    """查看商品详情"""
    result = _api("get", f"/products/{args.id}")
    _pprint(result)


def cmd_product_create(args):
    """发布商品/技能"""
    data = {
        "name": args.name,
        "description": args.description or f"AI Skill: {args.name}",
        "price": args.price,
        "category": args.category or "skill",
        "tags": args.tags or "AI,agent",
        "source_type": args.source_type or "api",
        "source_code": args.source_code or "",
    }
    if args.encrypted and args.source_code:
        from cryptography.fernet import Fernet
        enc_result = _api("post", "/sandbox/encrypt-agent", {"source_code": args.source_code})
        data["encrypted_source"] = enc_result.get("encrypted_blob", "")
        data["source_code"] = ""
        print("🦐 源码已加密！虾入虾塘，能力可售不泄漏")
    result = _api("post", "/products/", data)
    _pprint(result)
    print(f"✅ 商品发布成功!")


def cmd_product_buy(args):
    """购买商品"""
    result = _api("post", f"/products/{args.id}/purchase")
    _pprint(result)


# ==================== Bounties ====================

def cmd_bounty_list(args):
    """列出悬赏任务"""
    result = _api("get", "/bounties/")
    bounties = result.get("bounties", result) if isinstance(result, dict) else result
    if isinstance(bounties, list):
        for b in bounties[:20]:
            status = b.get("status", "open")
            budget = b.get("budget_range", "¥?")
            print(f"  [{b.get('id','?')}] {b.get('title','?')} — {budget} | {status} | 📋{b.get('application_count',0)}申请")
    else:
        _pprint(result)


def cmd_bounty_create(args):
    """发布悬赏"""
    data = {
        "title": args.title,
        "description": args.description or f"悬赏: {args.title}",
        "budget_range": args.budget or "¥1000-5000",
        "category": args.category or "agent",
        "tags": args.tags or "bounty",
        "deadline": args.deadline or "2026-12-31",
    }
    result = _api("post", "/bounties/", data)
    _pprint(result)
    print("✅ 悬赏发布成功!")


def cmd_bounty_deliver(args):
    """提交悬赏作品"""
    # Read delivery content
    content = args.content
    if args.file:
        with open(args.file) as f:
            content = f.read()
    data = {
        "bounty_id": args.bounty_id,
        "content": content,
        "notes": args.notes or "",
    }
    result = _api("post", f"/bounties/{args.bounty_id}/deliver", data)
    _pprint(result)
    print("✅ 作品提交成功! 完成悬赏可获得积分奖励")


# ==================== Sandbox ====================

def cmd_sandbox_status(args):
    """查看沙盒状态"""
    result = _api("get", "/sandbox/status")
    _pprint(result)


def cmd_sandbox_start(args):
    """启动沙盒"""
    result = _api("post", f"/sandbox/start?language={args.language or 'python'}")
    _pprint(result)


def cmd_sandbox_exec(args):
    """在沙盒中执行代码"""
    code = args.code
    if args.file:
        with open(args.file) as f:
            code = f.read()
    data = {"code": code, "language": args.language or "python", "encrypted": args.encrypted}
    result = _api("post", "/sandbox/execute", data)
    _pprint(result)


def cmd_sandbox_stop(args):
    """停止沙盒"""
    result = _api("delete", "/sandbox/stop")
    _pprint(result)


# ==================== Chat (OpenAI Compatible) ====================

def cmd_chat(args):
    """OpenAI兼容聊天 — model=agent-{id}/skill-{id}/GLM-5.1-FP8"""
    messages = []
    if args.system:
        messages.append({"role": "system", "content": args.system})
    messages.append({"role": "user", "content": args.message})

    data = {
        "model": args.model or "GLM-5.1-FP8",
        "messages": messages,
        "stream": False,
        "temperature": args.temperature or 0.7,
    }
    result = _api("post", "/sandbox/v1/chat/completions", data)
    if isinstance(result, dict) and "choices" in result:
        content = result["choices"][0].get("message", {}).get("content", "")
        print(content)
    else:
        _pprint(result)


