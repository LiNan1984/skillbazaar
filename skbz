# ==================== Encrypt ====================

def cmd_encrypt(args):
    """虾塘加密 — 加密Agent源码"""
    code = args.source
    if args.file:
        with open(args.file) as f:
            code = f.read()
    result = _api("post", "/sandbox/encrypt-agent", {"source_code": code})
    _pprint(result)
    if args.output:
        with open(args.output, "w") as f:
            json.dump(result, f, ensure_ascii=False)
        print(f"✅ 加密结果已保存到 {args.output}")


# ==================== Main ====================

def main():
    parser = argparse.ArgumentParser(
        prog="skbz",
        description="🦐 SkillBazaar CLI — AI技能集市命令行工具 | 龙虾大舞台有技能你就来",
    )
    sub = parser.add_subparsers(dest="command", help="子命令")

    # --- auth ---
    auth = sub.add_parser("auth", help="认证管理")
    auth_sub = auth.add_subparsers(dest="subcommand")
    
    login = auth_sub.add_parser("login", help="登录")
    login.add_argument("--email", "-e", required=True)
    login.add_argument("--password", "-p", required=True)
    
    register = auth_sub.add_parser("register", help="注册")
    register.add_argument("--email", "-e", required=True)
    register.add_argument("--password", "-p", required=True)
    register.add_argument("--nickname", "-n")
    
    auth_sub.add_parser("whoami", help="查看当前用户")

    # --- product ---
    prod = sub.add_parser("product", help="商品/技能管理")
    prod_sub = prod.add_subparsers(dest="subcommand")
    
    p_list = prod_sub.add_parser("list", help="列出商品")
    p_list.add_argument("--category", "-c")
    p_list.add_argument("--search", "-s")
    p_list.add_argument("--page", "-p", type=int)
    
    p_info = prod_sub.add_parser("info", help="商品详情")
    p_info.add_argument("id", type=int)
    
    p_create = prod_sub.add_parser("create", help="发布商品")
    p_create.add_argument("--name", "-n", required=True)
    p_create.add_argument("--description", "-d")
    p_create.add_argument("--price", type=int, required=True)
    p_create.add_argument("--category", "-c")
    p_create.add_argument("--tags", "-t")
    p_create.add_argument("--source-type")
    p_create.add_argument("--source-code")
    p_create.add_argument("--encrypted", action="store_true", help="🦐 虾塘加密")
    
    p_buy = prod_sub.add_parser("buy", help="购买商品")
    p_buy.add_argument("id", type=int)

    # --- bounty ---
    bounty = sub.add_parser("bounty", help="悬赏市场")
    b_sub = bounty.add_subparsers(dest="subcommand")
    
    b_sub.add_parser("list", help="列出悬赏")
    
    b_create = b_sub.add_parser("create", help="发布悬赏")
    b_create.add_argument("--title", "-t", required=True)
    b_create.add_argument("--description", "-d")
    b_create.add_argument("--budget", "-b")
    b_create.add_argument("--category", "-c")
    b_create.add_argument("--tags")
    b_create.add_argument("--deadline")
    
    b_deliver = b_sub.add_parser("deliver", help="提交作品")
    b_deliver.add_argument("--bounty-id", type=int, required=True)
    b_deliver.add_argument("--content", "-c")
    b_deliver.add_argument("--file", "-f", help="从文件读取内容")
    b_deliver.add_argument("--notes")

    # --- sandbox ---
    sandbox = sub.add_parser("sandbox", help="沙盒管理 🦐")
    s_sub = sandbox.add_subparsers(dest="subcommand")
    
    s_sub.add_parser("status", help="沙盒状态")
    
    s_start = s_sub.add_parser("start", help="启动沙盒")
    s_start.add_argument("--language", "-l", default="python")
    
    s_exec = s_sub.add_parser("exec", help="执行代码")
    s_exec.add_argument("--code", "-c")
    s_exec.add_argument("--file", "-f", help="从文件读取代码")
    s_exec.add_argument("--language", "-l", default="python")
    s_exec.add_argument("--encrypted", action="store_true")
    
    s_sub.add_parser("stop", help="停止沙盒")

    # --- chat ---
    chat_p = sub.add_parser("chat", help="OpenAI兼容聊天")
    chat_p.add_argument("--model", "-m", default="GLM-5.1-FP8", help="模型: agent-{id}/skill-{id}/GLM-5.1-FP8")
    chat_p.add_argument("--message", "-msg", required=True)
    chat_p.add_argument("--system", "-s")
    chat_p.add_argument("--temperature", "-t", type=float, default=0.7)

    # --- points ---
    points = sub.add_parser("points", help="积分管理")
    pt_sub = points.add_subparsers(dest="subcommand")
    
    pt_sub.add_parser("balance", help="积分余额")
    pt_sub.add_parser("checkin", help="每日签到")
    
    pt_redeem = pt_sub.add_parser("redeem", help="兑换(积分→沙盒时长/金币)")
    pt_redeem.add_argument("--amount", "-a", type=int, required=True, help="数量(小时或金币)")
    pt_redeem.add_argument("--type", "-t", default="sandbox", choices=["sandbox", "coins"])

    # --- cron ---
    cron_p = sub.add_parser("cron", help="Cron商店")
    c_sub = cron_p.add_subparsers(dest="subcommand")
    
    c_sub.add_parser("list", help="列出Cron商品")
    
    c_sub = c_sub.add_parser("subscribe", help="订阅")
    c_sub.add_argument("--product-id", type=int, required=True)
    c_sub.add_argument("--email", "-e", required=True)

    # --- agent ---
    agent_p = sub.add_parser("agent", help="智能体管理")
    a_sub = agent_p.add_subparsers(dest="subcommand")
    
    a_create = a_sub.add_parser("create", help="创建智能体")
    a_create.add_argument("--name", "-n", required=True)
    a_create.add_argument("--prompt", "-p")
    a_create.add_argument("--description", "-d")
    a_create.add_argument("--model", "-m", default="GLM-5.1-FP8")
    
    a_run = a_sub.add_parser("run", help="运行智能体")
    a_run.add_argument("--agent-id", type=int, required=True)
    a_run.add_argument("--message", "-m", required=True)

    # --- encrypt ---
    enc = sub.add_parser("encrypt", help="🦐 虾塘加密")
    enc.add_argument("--source", "-s", help="源码字符串")
    enc.add_argument("--file", "-f", help="从文件读取源码")
    enc.add_argument("--output", "-o", help="保存加密结果")

    # --- library ---
    sub.add_parser("library", help="我的库")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return

    # Route commands
    routes = {
        ("auth", "login"): cmd_auth_login,
        ("auth", "register"): cmd_auth_register,
        ("auth", "whoami"): cmd_auth_whoami,
        ("product", "list"): cmd_product_list,
        ("product", "info"): cmd_product_info,
        ("product", "create"): cmd_product_create,
        ("product", "buy"): cmd_product_buy,
        ("bounty", "list"): cmd_bounty_list,
        ("bounty", "create"): cmd_bounty_create,
        ("bounty", "deliver"): cmd_bounty_deliver,
        ("sandbox", "status"): cmd_sandbox_status,
        ("sandbox", "start"): cmd_sandbox_start,
        ("sandbox", "exec"): cmd_sandbox_exec,
        ("sandbox", "stop"): cmd_sandbox_stop,
        ("chat",): cmd_chat,
        ("points", "balance"): cmd_points_balance,
        ("points", "checkin"): cmd_points_checkin,
        ("points", "redeem"): cmd_points_redeem,
        ("cron", "list"): cmd_cron_list,
        ("cron", "subscribe"): cmd_cron_subscribe,
        ("agent", "create"): cmd_agent_create,
        ("agent", "run"): cmd_agent_run,
        ("encrypt",): cmd_encrypt,
        ("library",): cmd_library_list,
    }

    key = (args.command, args.subcommand) if hasattr(args, 'subcommand') and args.subcommand else (args.command,)
    handler = routes.get(key)
    if handler:
        handler(args)
    else:
        parser.parse_args(["--help"])


if __name__ == "__main__":
    main()
